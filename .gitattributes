# Every supported source and contract text format is checked out with LF so
# frozen hashes and generated-contract diff checks are independent of a
# contributor's core.autocrlf setting. Binary fixtures are never transformed.
.gitattributes text eol=lf
*.c text eol=lf
*.css text eol=lf
*.go text eol=lf
*.h text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf

*.db binary
*.db-shm binary
*.db-wal binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
